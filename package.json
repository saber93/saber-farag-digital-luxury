{
  "name": "saber-el-shafey-analytics-portfolio",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "postinstall": "\"$npm_node_execpath\" scripts/patch-babel8-interop.mjs",
    "runtime:check": "\"$npm_node_execpath\" scripts/runtime-check.mjs",
    "lock:check": "\"$npm_node_execpath\" scripts/lock-check.mjs",
    "dev": "\"$npm_node_execpath\" node_modules/vite/bin/vite.js dev",
    "build": "\"$npm_node_execpath\" scripts/build.mjs",
    "build:production": "VITE_DEPLOY_CONTEXT=production \"$npm_node_execpath\" scripts/build.mjs",
    "build:netlify": "\"$npm_node_execpath\" scripts/run-gates.mjs netlify",
    "preview": "\"$npm_node_execpath\" node_modules/vite/bin/vite.js preview",
    "lint": "\"$npm_node_execpath\" node_modules/eslint/bin/eslint.js .",
    "typecheck": "\"$npm_node_execpath\" node_modules/typescript/bin/tsc --noEmit",
    "test": "\"$npm_node_execpath\" node_modules/vitest/vitest.mjs run",
    "test:unit": "\"$npm_node_execpath\" node_modules/vitest/vitest.mjs run",
    "test:e2e": "\"$npm_node_execpath\" node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "\"$npm_node_execpath\" node_modules/@playwright/test/cli.js install chromium",
    "seo:check": "\"$npm_node_execpath\" scripts/seo-check.mjs",
    "security:scan": "\"$npm_node_execpath\" scripts/security-scan.mjs",
    "security:artifacts": "\"$npm_node_execpath\" scripts/security-scan.mjs --artifacts",
    "output:check": "\"$npm_node_execpath\" scripts/output-check.mjs",
    "format": "\"$npm_node_execpath\" node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "\"$npm_node_execpath\" node_modules/prettier/bin/prettier.cjs --check .",
    "verify": "\"$npm_node_execpath\" scripts/run-gates.mjs verify",
    "verify:full": "\"$npm_node_execpath\" scripts/run-gates.mjs full"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.32.0",
    "@netlify/vite-plugin-tanstack-start": "1.3.17",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@babel/core": "8.0.1",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0"
  }
}
